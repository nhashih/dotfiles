#!/bin/sh

IFACE="${1:-}"
ACTION="${2:-}"

[ "$IFACE" = "wlan0" ] || exit 0

case "$ACTION" in
up | dhcp4-change | dhcp6-change | reapply)
  ;;
*)
  exit 0
  ;;
esac

/usr/bin/resolvectl dns "$IFACE" 1.1.1.1 1.0.0.1
/usr/bin/resolvectl domain "$IFACE" '~.'
/usr/bin/resolvectl dnsovertls "$IFACE" no
/usr/bin/resolvectl flush-caches
